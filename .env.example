# AVH API
AVH_API_URL=https://agenticvaluehub.com
AVH_API_KEY=your-news-ingest-api-key

# AI Provider (for summarization + analysis)
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

# Image Provider (for article images)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=your-image-api-key
IMAGE_MODEL=dall-e-3

# Image CDN (where to upload generated images)
IMAGE_CDN_URL=https://cdn.agenticvaluehub.com/images

# YouTube Monitoring (optional — channel RSS works without an API key;
# set this only if you want richer metadata via the YouTube Data API)
YOUTUBE_API_KEY=

# Web Scraping
SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; AgenticValueHubJournalist/0.1; +https://agenticvaluehub.com)

# Scheduling
CRON_SCHEDULE=0 */6 * * *

# Logging
LOG_LEVEL=info